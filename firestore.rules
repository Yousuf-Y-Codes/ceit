rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions — strictly allow only @pdsb.net accounts
    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower().matches('.*@pdsb\\.net$');
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.email.lower().matches('^p[0-9]+@pdsb\\.net$') ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to create/update their own profile, or teachers to manage profiles
      allow create, update: if isOwner(userId) || isTeacher();
      allow delete: if isTeacher();
    }

    // Inventory items
    match /items/{itemId} {
      // Any logged-in student or teacher can read items
      allow read: if isAuthenticated();
      // Only teachers can create or delete items
      allow create, delete: if isTeacher();
      // Teachers can update any field; students can only update availableQuantity during checkouts/returns
      allow update: if isTeacher() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableQuantity', 'updatedAt'])
      );
    }

    // Checkouts & Sign-outs
    match /checkouts/{checkoutId} {
      // Teachers can read all checkouts; students can read their own
      allow read: if isTeacher() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Students can create a checkout under their own UID; teachers can also create guest checkouts
      allow create: if isTeacher() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      // Teachers or the student who checked it out can mark it as returned
      allow update: if isTeacher() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isTeacher();
    }
  }
}
